{
  "name": "systembuilder/control-plane",
  "description": "SystemBuilder Laravel Control Plane tracer seed",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "8.5.12",
    "laravel/framework": "13.38.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit -c phpunit.xml"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
